map InspectSLAHelperTables()
{
	orgId = "669589020";
	workspaceId = "1736024000007583918";
	result = Map();
	headersMap = Map();
	headersMap.put("ZANALYTICS-ORGID",orgId);
	// --------------------------------------------------
	// Display Item List Query
	// --------------------------------------------------
	try 
	{
		displayQueryResponse = invokeurl
		[
			url :"https://analyticsapi.zoho.com/restapi/v2/workspaces/" + workspaceId + "/views/1736024000008310024/metadata"
			type :GET
			headers:headersMap
			connection:"zoho_analytics_connection1"
		];
		result.put("Display Item List Query",displayQueryResponse);
	}	catch (e)
	{
		result.put("Display Item List Query Error",e.toString());
	}
	// --------------------------------------------------
	// Refine recurring item products
	// --------------------------------------------------
	try 
	{
		refineResponse = invokeurl
		[
			url :"https://analyticsapi.zoho.com/restapi/v2/workspaces/" + workspaceId + "/views/1736024000007804002/metadata"
			type :GET
			headers:headersMap
			connection:"zoho_analytics_connection1"
		];
		result.put("Refine recurring item products",refineResponse);
	}	catch (e)
	{
		result.put("Refine recurring item products Error",e.toString());
	}
	// --------------------------------------------------
	// Recurring Item Display - SKU
	// --------------------------------------------------
	try 
	{
		skuResponse = invokeurl
		[
			url :"https://analyticsapi.zoho.com/restapi/v2/workspaces/" + workspaceId + "/views/1736024000007767278/metadata"
			type :GET
			headers:headersMap
			connection:"zoho_analytics_connection1"
		];
		result.put("Recurring Item Display - SKU",skuResponse);
	}	catch (e)
	{
		result.put("Recurring Item Display - SKU Error",e.toString());
	}
	// --------------------------------------------------
	// SLA List
	// --------------------------------------------------
	try 
	{
		slaListResponse = invokeurl
		[
			url :"https://analyticsapi.zoho.com/restapi/v2/workspaces/" + workspaceId + "/views/1736024000007767230/metadata"
			type :GET
			headers:headersMap
			connection:"zoho_analytics_connection1"
		];
		result.put("SLA List",slaListResponse);
	}	catch (e)
	{
		result.put("SLA List Error",e.toString());
	}
	result.put("status","ready");
	result.put("message","SLA helper table metadata loaded.");
	return result;
}
